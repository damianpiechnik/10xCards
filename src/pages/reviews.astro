---
import Layout from "@/layouts/Layout.astro";
import ReviewQueue from "@/components/reviews/ReviewQueue";

// Additional security layer - verify user is authenticated
const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/sign-in");
}
---

<Layout title="Powtórki">
  <main class="mx-auto flex min-h-screen w-full max-w-5xl flex-col gap-6 px-4 py-10">
    <header class="space-y-2">
      <h1 class="text-2xl font-semibold text-foreground">Powtórki</h1>
      <p class="text-sm text-muted-foreground">Sprawdź, które fiszki są gotowe do nauki i rozpocznij sesję powtórek.</p>
    </header>
    <section class="w-full">
      <ReviewQueue client:load />
    </section>
  </main>
</Layout>
