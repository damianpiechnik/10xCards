---
import Layout from "@/layouts/Layout.astro";
import GenerationRequestHistory from "@/components/generate/GenerationRequestHistory";

// Additional security layer - verify user is authenticated
const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/sign-in");
}
---

<Layout title="Historia generacji">
  <main class="flex min-h-screen items-center justify-center px-4 py-12">
    <section class="w-full max-w-3xl">
      <GenerationRequestHistory client:load />
    </section>
  </main>
</Layout>
