---
import "../styles/global.css";
import AppShell from "../components/AppShell";

interface Props {
  title?: string;
}

const { title = "10xCards" } = Astro.props;

// Get user and session from middleware
const { user, session } = Astro.locals;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <AppShell client:load initialUser={user} initialSession={session}>
      <slot />
    </AppShell>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
