---
import Layout from "@/layouts/Layout.astro";
import GenerationRequestDetails from "@/components/generate/GenerationRequestDetails";

// Additional security layer - verify user is authenticated
const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/sign-in");
}

const { id } = Astro.params;
const requestId = typeof id === "string" ? id : "";
---

<Layout title="Szczegóły generacji">
  <main class="flex min-h-screen items-center justify-center px-4 py-12">
    <section class="w-full max-w-3xl">
      {requestId ? <GenerationRequestDetails requestId={requestId} client:load /> : <p>Nieprawidłowy identyfikator.</p>}
    </section>
  </main>
</Layout>
